# Copy to .env and fill in. Never commit .env.

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (Google Cloud > APIs & Services > Credentials).
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the app, e.g. http://localhost:3000 or https://your-domain
NEXTAUTH_URL=http://localhost:3000
# Signs session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Groq API keys for the coach. Several keys, comma-separated, rotate when one hits its limit.
GROQ_API_KEY=
# Coach questions per person per day (default 100)
COACH_DAILY_LIMIT=

# Optional: only these Google accounts may sign in (comma-separated). Empty = anyone.
ALLOWED_EMAILS=
